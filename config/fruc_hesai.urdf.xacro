<?xml version="1.0"?>
<!-- FRUC Hesai-128 platform.
     ============================ INCOMPLETE ============================
     fruc_lio_sam ships NO Hesai URDF. params_hesai.yaml sets lidarFrame to
     "hesai_lidar", so *some* base_link -> hesai_lidar transform has to exist or
     TransformFusion's lidar->baselink lookup fails every IMU callback.

     The offsets below are PLACEHOLDER ZEROS. They must be replaced with the
     real measured mount before this platform is trusted.

     Do not be tempted to copy extrinsicTrans from params_hesai.yaml into here:
     that value ([-0.388186, 0.022004, 0.066264]) is LIO-SAM's lidar-to-IMU
     translation (T_lb), applied internally in imuPreintegration. It is a
     different quantity from the base_link-to-sensor mount this file describes.
     ==================================================================== -->
<robot name="lio" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_link"/>

  <!-- IMU -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Hesai lidar. TODO(fruc): replace with the measured mount. -->
  <link name="hesai_lidar"/>
  <joint name="hesai_joint" type="fixed">
    <parent link="base_link"/>
    <child link="hesai_lidar"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- GPS. TODO(fruc): replace with the measured antenna position.
       Unused while gpsTopic stays "odometry/gpsz" (GPS disabled upstream). -->
  <link name="gps"/>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
