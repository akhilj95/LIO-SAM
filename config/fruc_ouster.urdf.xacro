<?xml version="1.0"?>
<!-- FRUC Ouster OS-128 platform ("apparatus" rig).

     Ported from Forestry-Robotics-UC/fruc_lio_sam
     launch/include/config/apparatus.urdf.xacro - geometry unchanged.

     NOT robot_ouster_he-bo.urdf.xacro, which this file used to transcribe.
     That was wrong: params_ouster.yaml's extrinsics come from FRUC's
     config/ouster.yaml, and those numbers are this rig's, exactly. Compose
     base_link -> os_sensor -> os_lidar and invert against base_link -> xsens_imu:

       R = Rz(180)^T                            = [-1 0 0; 0 -1 0; 0 0 1]
       t = Rz(180)^T ((-0.015121,-0.046950,0.0586) - (0,0,0.206440))
         = (0.015121, 0.046950, -0.147840)

     which is ouster.yaml's extrinsicRot and extrinsicTrans [0.0151, 0.0470,
     -0.1478] to every digit it prints. he-bo's geometry (xsens at base_link
     identity, os_lidar at (0.15,0,0.13) unrotated) would instead demand
     (-0.15, 0, -0.13) with R = I - nothing like it. he-bo is orphaned upstream:
     no FRUC params file matches it, so nothing here needs it.

     The 180 deg yaw on base_link -> os_sensor is upstream's and is kept. Note
     it sits on the MOUNT here, unlike fruc_curtmini.urdf.xacro where the same
     180 belongs to the OS-1's internal lidar_to_sensor_transform and sits on
     os_sensor -> os_lidar. This file leaves os_sensor -> os_lidar identity
     because that is how FRUC calibrated the rest of the rig against it; the
     composition base_link -> os_lidar = Rz(180) is what the extrinsics use, and
     it is the same either way.

     ============================== GPS GAP ==============================
     apparatus.urdf.xacro declares NO gps link, and params_ouster.yaml still
     runs navsat_transform_node. That node takes gps_frame_id from the incoming
     gps/fix header (navsat_transform.cpp:736) and does
     lookupTransform(base_link, gps_frame_id) (:650, :697), so whatever
     frame_id that rig's fix messages carry MUST exist below or the GPS chain
     never initialises. No antenna position is invented here - measure it and
     add the link. Nothing else in this file depends on it.
     =====================================================================

     Deliberately no "lidar_link": mapOptimization broadcasts odom -> lidar_link
     itself, and declaring it here too would give that frame two parents. -->
<robot name="lio" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Base. Upstream carries a mesh visual (apperatus.obj); dropped, the file
       is not in the repo and robot_state_publisher does not need it. -->
  <link name="base_link"/>

  <!-- Ouster sensor body, yawed 180 deg on the mount. -->
  <link name="os_sensor"/>
  <joint name="base_link_to_os_sensor" type="fixed">
    <parent link="base_link"/>
    <child link="os_sensor"/>
    <origin xyz="0 0 0.206440" rpy="0 0 3.141592653589793"/>
  </joint>

  <!-- Ouster lidar frame. Identity to the sensor body, as upstream has it;
       params_ouster.yaml names this as lidarFrame. -->
  <link name="os_lidar"/>
  <joint name="os_sensor_to_os_lidar" type="fixed">
    <parent link="os_sensor"/>
    <child link="os_lidar"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Ouster internal IMU, from upstream's Kalibr camera-IMU calibration.
       Unused by this config (LIO-SAM reads the Xsens), kept so /ouster/imu
       stays resolvable. -->
  <link name="os_imu"/>
  <joint name="os_sensor_to_os_imu" type="fixed">
    <parent link="os_sensor"/>
    <child link="os_imu"/>
    <origin xyz="-0.03516933627986119 0.026844313894637633 0.05514881960085294"
            rpy="0.0527437133816158 -0.06297509863959863 1.5228784764076906"/>
  </joint>

  <!-- Xsens IMU, source of /imu/data/corrected and the frame every extrinsic
       in params_ouster.yaml is measured against. If you change this origin,
       recompute extrinsicTrans/extrinsicRot there.

       robot_localization's ekf_node transforms its IMU input into
       base_link_frame through TF, so if the /imu/data/corrected messages carry
       a frame_id other than "xsens_imu", every IMU sample is dropped and the
       whole GPS chain silently never initialises. LIO-SAM itself is unaffected
       either way - it uses extrinsicRot/extrinsicRPY, not TF. -->
  <link name="xsens_imu"/>
  <joint name="base_link_to_xsens_imu" type="fixed">
    <parent link="base_link"/>
    <child link="xsens_imu"/>
    <origin xyz="-0.015121 -0.046950 0.0586" rpy="0 0 0"/>
  </joint>

  <!-- RealSense. Unused by LIO-SAM, carried over for completeness. -->
  <link name="camera_link"/>
  <joint name="os_sensor_to_camera_link" type="fixed">
    <parent link="os_sensor"/>
    <child link="camera_link"/>
    <origin xyz="-0.018599905044461885 0.08479126746983127 -0.09082252118430068"
            rpy="0.0013625367954899733 0.003069697768602153 1.558103710329454"/>
  </joint>

  <link name="camera_depth_frame"/>
  <joint name="camera_link_to_depth_frame" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_frame_to_optical" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>

  <link name="camera_color_frame"/>
  <joint name="camera_link_to_color_frame" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_frame_to_optical" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>

</robot>
